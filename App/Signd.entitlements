<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode expands each build setting when it signs. The file names no team and no literal container. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.victor-software-house.signd</string>
		<!-- The TLS identities' group comes second: a keychain item added with no group takes the first one, which must stay signd's own. -->
		<string>$(TeamIdentifierPrefix)com.victor-software-house.identities</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
